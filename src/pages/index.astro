---
import BaseLayout from "../components/BaseLayout.astro";
import TextPipelineHero from "../components/TextPipelineHero.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PubList from "../components/PubList.astro";
import { site } from "../data/site";
import { getCollection } from "astro:content";
import { getPublications } from "../lib/content";
import { withBase } from "../lib/url";

const people = await getCollection("people");
const pubs = await getPublications();
const recent = pubs.filter((p) => p.data.featured).slice(0, 5);

const currentCount = people.filter((p) => p.data.status === "current").length;
const collabCount = people.filter((p) => p.data.status === "collaborator").length;
const alumniCount = people.filter((p) => p.data.status === "alumni").length;

const stats = [
  { value: `${site.projects.length}`, label: "Active Applied Projects" },
  { value: `${pubs.length}+`, label: "Selected Publications" },
  { value: `${collabCount}`, label: "Global Collaborators" },
  { value: `${currentCount + alumniCount}`, label: "Researchers & Alumni" },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-primary-100/70 bg-gradient-to-b from-primary-50/80 via-paper to-white">
    <div class="bg-corpus-grid pointer-events-none absolute inset-0 opacity-45" aria-hidden="true"></div>
    <div class="container-page relative py-14 sm:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-5 flex justify-center">
          <img
            src={withBase("/icon-512.png")}
            alt="Amrita Computational Text Analysis Lab emblem"
            width="104"
            height="104"
            class="h-24 w-24 rounded-full bg-white object-cover shadow-sm ring-2 ring-primary-200/80 sm:h-28 sm:w-28"
          />
        </div>
        <p class="text-xs font-semibold tracking-[0.14em] text-primary-700 uppercase sm:text-sm">
          {site.institution} · {site.university}
        </p>
        <h1 class="mt-3 text-4xl leading-[1.12] font-semibold tracking-tight text-slate-900 sm:text-5xl">
          {site.name}
        </h1>
        <p class="mt-3 font-serif text-lg italic text-primary-800 sm:text-xl">
          “{site.tagline}”
        </p>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg">
          {site.description}
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href={withBase("/research")}
            class="rounded-md bg-primary-700 px-5 py-2.5 text-sm font-semibold text-white shadow-xs transition-colors hover:bg-primary-800"
          >
            Explore our research
          </a>
          <a
            href={withBase("/people")}
            class="rounded-md border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-primary-300 hover:bg-primary-50/40 hover:text-primary-800"
          >
            Meet the team
          </a>
          <a
            href={withBase("/publications")}
            class="rounded-md border border-transparent px-4 py-2.5 text-sm font-semibold text-primary-700 transition-colors hover:bg-primary-50"
          >
            Publications &rarr;
          </a>
        </div>
      </div>

      <!-- Custom Animated Computational Text Analysis Pipeline -->
      <div class="mt-14 rounded-2xl border border-primary-100 bg-white/90 px-4 py-8 shadow-xs backdrop-blur sm:px-8">
        <p class="mb-6 text-center text-xs font-semibold tracking-[0.14em] text-slate-500 uppercase">
          Our End-to-End Applied Language Intelligence Pipeline
        </p>
        <TextPipelineHero />
      </div>
    </div>
  </section>

  <!-- Quick editorial metrics strip -->
  <section class="border-b border-slate-200/80 bg-white">
    <div class="container-page grid grid-cols-2 gap-6 py-8 sm:grid-cols-4">
      {
        stats.map((s) => (
          <div class="text-center">
            <p class="font-serif text-3xl font-semibold text-primary-800">{s.value}</p>
            <p class="mt-1 text-xs font-medium tracking-wide text-slate-500 uppercase">{s.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- About, Mission, Vision & Research / Build / Impact Pillars -->
  <section class="bg-paper py-16 sm:py-20">
    <div class="container-page">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <div class="mb-3 h-0.5 w-10 rounded-full bg-primary-600"></div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900">
            About AmritaCTALab
          </h2>
          <div class="mt-5 space-y-4 text-base leading-relaxed text-slate-600">
            {site.about.map((para) => <p>{para}</p>)}
          </div>
        </div>

        <div class="space-y-4 lg:col-span-5">
          <div class="rounded-xl border border-primary-100 bg-white p-6 shadow-xs">
            <p class="text-xs font-semibold tracking-wider text-primary-700 uppercase">
              Mission
            </p>
            <p class="mt-2 font-serif text-lg leading-snug text-slate-900">
              {site.mission}
            </p>
          </div>
          <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-xs">
            <p class="text-xs font-semibold tracking-wider text-accent-700 uppercase">
              Vision
            </p>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">
              {site.vision}
            </p>
          </div>
        </div>
      </div>

      <!-- Research · Build · Impact -->
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          site.pillars.map((pillar, idx) => (
            <div class="rounded-xl border border-slate-200/90 bg-white p-6">
              <span class="font-serif text-sm font-semibold text-primary-700">
                0{idx + 1}
              </span>
              <h3 class="mt-1 font-serif text-xl font-semibold text-slate-900">
                {pillar.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">
                {pillar.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Active Projects ("What we are building right now") -->
  <section class="border-t border-slate-200 bg-white py-16 sm:py-20">
    <div class="container-page">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="mb-3 h-0.5 w-10 rounded-full bg-primary-600"></div>
          <h2 class="font-serif text-3xl font-semibold text-slate-900">
            What we are building
          </h2>
          <p class="mt-2 max-w-2xl text-sm text-slate-600 sm:text-base">
            Applied computational text analysis and language intelligence systems across six societal pillars.
          </p>
        </div>
        <a
          href={withBase("/research")}
          class="group inline-flex shrink-0 items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
        >
          Explore research taxonomy
          <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {site.projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- Recent Publications -->
  {
    recent.length > 0 && (
      <section class="border-t border-slate-200 bg-paper py-16 sm:py-20">
        <div class="container-page">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <div class="mb-3 h-0.5 w-10 rounded-full bg-primary-600" />
              <h2 class="font-serif text-3xl font-semibold text-slate-900">
                Recent publications
              </h2>
            </div>
            <a
              href={withBase("/publications")}
              class="group inline-flex shrink-0 items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
            >
              All {pubs.length} publications
              <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                &rarr;
              </span>
            </a>
          </div>
          <div class="rounded-2xl border border-slate-200/80 bg-white px-6 py-2 shadow-xs">
            <PubList pubs={recent} />
          </div>
        </div>
      </section>
    )
  }

  <!-- Join & Collaborate Callout -->
  <section class="border-t border-slate-200 bg-white py-16">
    <div class="container-page">
      <div class="overflow-hidden rounded-2xl border border-primary-200/80 bg-gradient-to-br from-primary-50 via-white to-accent-50/60 p-8 sm:p-12">
        <div class="grid items-center gap-8 lg:grid-cols-12">
          <div class="lg:col-span-7">
            <p class="text-xs font-semibold tracking-[0.14em] text-primary-700 uppercase">
              Join or Collaborate
            </p>
            <h2 class="mt-2 font-serif text-3xl font-semibold text-slate-900">
              Curious about how language technologies can address societal challenges?
            </h2>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
              We welcome motivated B.Tech., M.Tech., and Ph.D. students, postdoctoral fellows, and academic or industry collaborators working in Computational Text Analysis, SocialNLP, and IndicNLP.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a
                href={withBase("/contact")}
                class="rounded-md bg-primary-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-800"
              >
                Join now / Contact us
              </a>
              <a
                href={`mailto:${site.email}`}
                class="rounded-md border border-primary-200 bg-white px-5 py-2.5 text-sm font-semibold text-primary-800 transition-colors hover:bg-primary-50"
              >
                {site.email}
              </a>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 lg:col-span-5">
            {
              site.joinTracks.map((t) => (
                <a
                  href={withBase("/contact#join")}
                  class="rounded-xl border border-primary-100 bg-white/90 p-4 transition-colors hover:border-primary-300 hover:bg-white"
                >
                  <p class="font-serif text-base font-semibold text-slate-900">{t.title}</p>
                  <p class="mt-0.5 text-xs text-slate-600">{t.audience}</p>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
