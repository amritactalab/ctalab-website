---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PubList from "../components/PubList.astro";
import { site } from "../data/site";
import { getResearchGroups } from "../lib/content";
import { withBase } from "../lib/url";

const groups = await getResearchGroups(4);
---

<BaseLayout
  title="Research"
  description="Active projects, societal domains, and computational text analysis methods at AmritaCTALab."
>
  <PageHeader
    eyebrow="What we do"
    title="Research"
    lead="We unite rigorous NLP methodology with real-world deployment — from interpretable semantic text kernels and Indic language processing to healthcare, legal, and crisis intelligence."
  />

  <!-- Active Applied Projects -->
  <section id="projects" class="scroll-mt-24 border-b border-slate-200 bg-white py-14">
    <div class="container-page">
      <div class="mb-3 h-1 w-12 rounded-full bg-primary-600"></div>
      <h2 class="font-serif text-3xl font-semibold tracking-tight text-slate-900">
        Active Projects
      </h2>
      <p class="mt-2 max-w-2xl text-slate-600">
        Six core initiatives currently underway at AmritaCTALab, moving from societal challenges to deployable prototypes.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {site.projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- Data-driven Research Taxonomy -->
  <div class="container-page space-y-16 py-14">
    {
      groups.map((group) => (
        <section>
          <div class="mb-3 h-1 w-12 rounded-full bg-primary-600"></div>
          <h2 class="font-serif text-3xl font-semibold tracking-tight text-slate-900 sm:text-4xl">
            {group.title}
          </h2>
          <p class="mt-2 max-w-2xl text-slate-600">{group.subtitle}</p>
          <div class="mt-8 space-y-12">
            {group.areas.map((area) => (
              <div id={area.slug} class="scroll-mt-24">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="font-serif text-2xl font-semibold text-slate-900">
                    {area.label}
                  </h3>
                  {area.total > area.pubs.length && (
                    <a
                      href={withBase(`/publications#${area.slug}`)}
                      class="group inline-flex shrink-0 items-center gap-1 text-sm font-medium text-primary-700 transition-colors hover:text-accent-600"
                    >
                      All {area.total} papers
                      <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
                        &rarr;
                      </span>
                    </a>
                  )}
                </div>
                <p class="mt-2 max-w-3xl text-slate-600">{area.blurb}</p>
                <div class="mt-4 rounded-xl border border-slate-200/80 bg-white px-5 py-1">
                  <PubList pubs={area.pubs} />
                </div>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
