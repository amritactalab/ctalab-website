---
import BaseLayout from "../components/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PubList from "../components/PubList.astro";
import { getPublications, getAreaCounts, AREA_LABELS, FILTER_GROUPS } from "../lib/content";
import { site } from "../data/site";

const pubs = await getPublications();
const areaCounts = await getAreaCounts();
const areaChips = FILTER_GROUPS.flatMap((g) => g.slugs);

const chip =
  "cursor-pointer rounded-full border border-slate-300 bg-white px-3 py-1 text-sm font-medium text-slate-600 transition-colors hover:border-primary-300 hover:bg-primary-50/40 data-[active]:border-primary-700 data-[active]:bg-primary-700 data-[active]:text-white";

const filters = [
  { key: "all", label: "All" },
  { key: "journal", label: "Journals" },
  { key: "chapter", label: "Book Chapters" },
  { key: "book", label: "Edited Books" },
  { key: "mentee", label: "With Lab Alumni/Staff" },
];
---

<BaseLayout
  title="Publications"
  description="Peer-reviewed journal articles, book chapters, and edited volumes from AmritaCTALab."
>
  <PageHeader
    eyebrow="Research output"
    title="Publications"
    lead="Peer-reviewed journals, book chapters, and edited books from AmritaCTALab and our international collaborators. Filter by publication type or research area, search by keyword, or copy BibTeX citations."
  />
  <div class="container-page py-12">
    <div class="mb-8 space-y-3 rounded-2xl border border-slate-200/90 bg-paper p-5">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <button
          type="button"
          id="filters-toggle"
          class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50 md:hidden"
          aria-controls="pub-filters"
          aria-expanded="false"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h18M6 12h12M10 19h4" />
          </svg>
          Filters
        </button>

        {site.social.scholar && (
          <a
            href={site.social.scholar}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-medium text-primary-700 hover:underline"
          >
            Full record on Google Scholar &rarr;
          </a>
        )}
      </div>

      <div id="pub-filters" class="hidden space-y-3 md:block">
        <div class="flex flex-wrap items-center gap-2">
          <span class="mr-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">Type</span>
          {
            filters.map((f) => (
              <button class={chip} data-filter={f.key} data-active={f.key === "all" ? "" : undefined}>
                {f.label} <span data-count />
              </button>
            ))
          }
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <span class="mr-1 text-xs font-semibold tracking-wide text-slate-500 uppercase">Area</span>
          <button class={chip} data-area="all" data-active>All areas</button>
          {
            areaChips.map((slug) => (
              <button class={chip} data-area={slug}>
                {AREA_LABELS[slug]}{" "}
                <span class="opacity-70">({areaCounts[slug] ?? 0})</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-1">
        <input
          type="search"
          id="pub-search"
          placeholder="Search title, author, venue, or year…"
          class="min-w-56 flex-1 rounded-md border border-slate-300 bg-white px-3.5 py-2 text-sm focus:border-primary-600 focus:outline-none"
        />
        <span id="pub-count" class="text-sm font-medium text-slate-600"></span>
      </div>
    </div>

    <PubList pubs={pubs} />

    <p id="pub-empty" class="hidden py-12 text-center text-slate-600">
      No publications match your current filters.
    </p>
  </div>

  <script>
    const list = document.getElementById("pub-list");
    const items = list
      ? ([...list.querySelectorAll<HTMLElement>("[data-pub]")] as HTMLElement[])
      : [];
    const search = document.getElementById("pub-search") as HTMLInputElement | null;
    const countEl = document.getElementById("pub-count");
    const emptyEl = document.getElementById("pub-empty");
    const filtersToggle = document.getElementById("filters-toggle");
    const filtersPanel = document.getElementById("pub-filters");

    filtersToggle?.addEventListener("click", () => {
      const open = filtersToggle.getAttribute("aria-expanded") === "true";
      filtersToggle.setAttribute("aria-expanded", String(!open));
      filtersPanel?.classList.toggle("hidden");
    });

    const filterBtns = [...document.querySelectorAll<HTMLElement>("[data-filter]")];
    const areaBtns = [...document.querySelectorAll<HTMLElement>("[data-area]")];

    let filter = "all";
    let area = "all";

    function matchesTypeFilter(li: HTMLElement, key: string): boolean {
      if (key === "all") return true;
      if (key === "mentee") return li.dataset.mentee === "true";
      return li.dataset.type === key;
    }

    function fillCounts() {
      for (const b of filterBtns) {
        const f = b.dataset.filter!;
        const c = items.filter((li) => matchesTypeFilter(li, f)).length;
        const span = b.querySelector("[data-count]");
        if (span) span.textContent = `(${c})`;
      }
    }

    function applyFilter() {
      const q = (search?.value ?? "").trim().toLowerCase();
      let n = 0;
      for (const li of items) {
        const okFilter = matchesTypeFilter(li, filter);
        const okArea = area === "all" || (li.dataset.areas ?? "").split(" ").includes(area);
        const okSearch = !q || (li.dataset.search ?? "").includes(q);
        const show = okFilter && okArea && okSearch;
        li.hidden = !show;
        if (show) n++;
      }
      if (countEl) countEl.textContent = `${n} of ${items.length} shown`;
      if (emptyEl) emptyEl.classList.toggle("hidden", n !== 0);
    }

    const setActive = (btns: HTMLElement[], active: HTMLElement) => {
      for (const x of btns) {
        if (x === active) x.setAttribute("data-active", "");
        else x.removeAttribute("data-active");
      }
    };

    for (const b of filterBtns)
      b.addEventListener("click", () => {
        filter = b.dataset.filter ?? "all";
        setActive(filterBtns, b);
        applyFilter();
      });

    for (const b of areaBtns)
      b.addEventListener("click", () => {
        area = b.dataset.area ?? "all";
        setActive(areaBtns, b);
        applyFilter();
      });

    search?.addEventListener("input", applyFilter);

    const hash = decodeURIComponent(location.hash.replace(/^#/, ""));
    if (hash) {
      const btn = areaBtns.find((b) => b.dataset.area === hash);
      if (btn) {
        area = hash;
        setActive(areaBtns, btn);
        filtersPanel?.classList.remove("hidden");
        filtersToggle?.setAttribute("aria-expanded", "true");
      }
    }

    fillCounts();
    applyFilter();
  </script>
</BaseLayout>
