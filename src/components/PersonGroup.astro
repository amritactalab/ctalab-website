---
import PersonCard from "./PersonCard.astro";
import type { Person } from "../lib/content";

interface Props {
  title: string;
  subtitle?: string;
  people: Person[];
}
const { title, subtitle, people } = Astro.props;
---

<section class="mb-16">
  <div class="mb-8 border-b border-slate-200 pb-3">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-serif text-2xl font-semibold text-slate-900">
        {title}
      </h2>
      <span class="text-xs font-medium text-slate-500">
        {people.length} {people.length === 1 ? "member" : "members"}
      </span>
    </div>
    {subtitle && <p class="mt-1 text-sm text-slate-600">{subtitle}</p>}
  </div>
  <div
    class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5"
  >
    {people.map((p) => <PersonCard person={p} />)}
  </div>
</section>
