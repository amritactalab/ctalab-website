---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { Publication } from "../lib/content";
import { authorIsPerson, personKey, menteeMatcher } from "../lib/content";
import { withBase } from "../lib/url";

interface Props {
  pubs: Publication[];
}
const { pubs } = Astro.props;

const people = await getCollection("people");
const dir = people.map((p) => ({
  slug: p.id,
  name: p.data.name,
  headshot: p.data.headshot,
  key: personKey(p.data.name, p.id),
}));

const findPerson = (author: string) =>
  dir.find((d) => authorIsPerson(author, d.key)) ?? null;

const isMentee = menteeMatcher(people);

const labPeopleFor = (p: Publication) => {
  const seen = new Set<string>();
  const out: typeof dir = [];
  for (const a of p.data.authors) {
    const d = findPerson(a);
    if (!d || !d.headshot || seen.has(d.slug)) continue;
    seen.add(d.slug);
    out.push(d);
  }
  return out;
};

const venueTypeLabel: Record<string, string> = {
  journal: "Journal",
  chapter: "Book Chapter",
  book: "Edited Book",
  conference: "Conference",
};

function makeBibtex(p: Publication) {
  const d = p.data;
  const firstAuthor = (d.authors[0] ?? "author").split(/[,\s]+/)[0].toLowerCase().replace(/[^a-z]/g, "");
  const titleWord = d.title.toLowerCase().replace(/[^a-z\s]/g, "").split(/\s+/).find((w) => w.length > 3) ?? "paper";
  const key = `${firstAuthor}${d.year}${titleWord}`;
  const entryType =
    d.venueType === "journal"
      ? "article"
      : d.venueType === "chapter"
        ? "incollection"
        : d.venueType === "book"
          ? "book"
          : "inproceedings";
  const venueField =
    d.venueType === "journal"
      ? "journal"
      : d.venueType === "book"
        ? "publisher"
        : "booktitle";
  const lines = [
    `@${entryType}{${key},`,
    `  author = {${d.authors.join(" and ")}},`,
    `  title = {${d.title}},`,
    `  ${venueField} = {${d.venue}},`,
    `  year = {${d.year}},`,
  ];
  if (d.doi) lines.push(`  doi = {${d.doi}},`);
  lines.push("}");
  return lines.join("\n");
}
---

<ol class="divide-y divide-slate-200/80" id="pub-list">
  {
    pubs.map((p) => {
      const d = p.data;
      const link = d.doi ? `https://doi.org/${d.doi}` : d.url;
      const search = `${d.title} ${d.authors.join(" ")} ${d.venue} ${d.year}`.toLowerCase();
      const menteeCoauthor = d.authors.some((a) => isMentee(a));
      const labPeople = labPeopleFor(p);
      const bibtex = makeBibtex(p);

      return (
        <li
          class="py-5"
          data-pub
          data-year={d.year}
          data-citations={typeof d.citations === "number" ? d.citations : -1}
          data-featured={d.featured}
          data-mentee={menteeCoauthor}
          data-pi-senior={d.piFirstOrSenior}
          data-type={d.venueType}
          data-openaccess={d.openAccess}
          data-areas={d.areas.join(" ")}
          data-search={search}
        >
          <p class="font-medium leading-snug text-slate-900">
            {link ? (
              <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-primary-700 hover:underline"
              >
                {d.title}
              </a>
            ) : (
              d.title
            )}
          </p>

          <p class="mt-1 text-sm text-slate-600">
            <span class:list={["authors", d.authors.length > 14 && "clamped"]}>
              {d.authors.map((a, i) => {
                const person = findPerson(a);
                return (
                  <span class="au">
                    {i > 0 && ", "}
                    {person ? (
                      <a
                        href={withBase(`/people/${person.slug}`)}
                        class="font-medium text-slate-900 transition-colors hover:text-primary-700 hover:underline"
                      >
                        {a}
                      </a>
                    ) : (
                      a
                    )}
                  </span>
                );
              })}
            </span>
          </p>

          <p class="mt-0.5 text-sm text-slate-600">
            <em>{d.venue}</em> · {d.year}
          </p>

          {labPeople.length > 0 && (
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
              {labPeople.map((m) => (
                <a
                  href={withBase(`/people/${m.slug}`)}
                  class="group flex items-center gap-2"
                  title={m.name}
                >
                  {m.headshot && (
                    <Image
                      src={m.headshot}
                      alt={m.name}
                      width={64}
                      height={64}
                      class="h-7 w-7 rounded-full object-cover object-top ring-1 ring-slate-200 transition-all group-hover:ring-primary-400"
                    />
                  )}
                  <span class="text-xs text-slate-600 transition-colors group-hover:text-primary-700">
                    {m.name}
                  </span>
                </a>
              ))}
            </div>
          )}

          <div class="mt-2.5 flex flex-wrap items-center gap-2 text-xs">
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 font-medium text-slate-700">
              {venueTypeLabel[d.venueType] ?? d.venueType}
            </span>
            {d.metrics && (
              <span class="rounded-full bg-primary-100 px-2.5 py-0.5 font-semibold text-primary-800">
                {d.metrics}
              </span>
            )}
            {menteeCoauthor && (
              <span class="rounded-full bg-accent-100 px-2.5 py-0.5 font-medium text-accent-800">
                With Lab Alumni/Staff
              </span>
            )}
            {d.openAccess && (
              <span class="rounded-full bg-emerald-100 px-2.5 py-0.5 font-medium text-emerald-800">
                Open access
              </span>
            )}
            {d.doi && (
              <a
                href={`https://doi.org/${d.doi}`}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-primary-700 hover:underline"
              >
                DOI
              </a>
            )}
            {!d.doi && d.url && (
              <a
                href={d.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-primary-700 hover:underline"
              >
                Publisher
              </a>
            )}
            {d.scholarUrl && (
              <a
                href={d.scholarUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-primary-700 hover:underline"
              >
                Scholar
              </a>
            )}
            <button
              type="button"
              data-copy-bib={bibtex}
              class="cursor-pointer rounded px-1.5 py-0.5 font-medium text-slate-500 transition-colors hover:bg-primary-50 hover:text-primary-700"
            >
              Copy BibTeX
            </button>
          </div>
        </li>
      );
    })
  }
</ol>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-bib]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const bib = btn.dataset.copyBib;
      if (!bib) return;
      try {
        await navigator.clipboard.writeText(bib);
        const orig = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => {
          btn.textContent = orig;
        }, 1600);
      } catch {
        // Fallback: select via prompt if clipboard blocked
      }
    });
  });
</script>
